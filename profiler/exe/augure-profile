#!/usr/bin/env ruby
# frozen_string_literal: true

# Bootstrap the bundler context from the checkout: the CLI runs from any
# working directory (when not already inside `bundle exec`).
unless defined?(Bundler)
  ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../../Gemfile", __dir__)
  require "bundler/setup"
end

require "optparse"
require_relative "../lib/augure-profiler"

out_path = nil
OptionParser.new do |opts|
  opts.banner = "Usage: augure-profile <binary> [-o target.facts]"
  opts.on("-o PATH", "Write facts to PATH (default: stdout)") { |v| out_path = v }
  opts.on("--version", "Print the version") do
    puts "augure-profiler #{AugureProfiler::VERSION}"
    exit 0
  end
end.parse!(ARGV)

binary = ARGV.shift or abort(<<~USAGE)
  Usage: augure-profile <binary> [-o target.facts]

  Generates an augure fact file from an ELF binary: checksec, PLT
  imports, unsafe-symbol hints and semantically classified gadgets.
  The binary is read-only; the profiler never executes anything.
USAGE

begin
  facts = AugureProfiler::Profiler.new(binary).facts
  if out_path
    File.write(out_path, facts.to_s)
    warn "augure-profile: wrote #{out_path} (#{facts.size} facts)"
  else
    puts facts
  end
rescue Metasm::ParseError, StandardError => e
  abort("augure-profile: #{binary}: #{e.message}")
end
