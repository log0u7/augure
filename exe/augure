#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "optparse"
require_relative "../lib/augure"

VERSION_LINE = "augure #{Augure::VERSION}"

options = {json: false, seed: nil}
parser = OptionParser.new do |opts|
  opts.banner = <<~USAGE

    #{VERSION_LINE} - the auditable exploitation decision layer

    Usage:
      augure analyze <facts-file | -> [options]   decide on facts
      augure doctor                               verify the environment
      augure rules                                print the rules-as-data table
      augure explain <technique>                  rules + knowledge for one technique
      augure --version                            print the version

    analyze options:
  USAGE
  opts.on("-j", "--json", "Emit the decision as JSON (schema: augure/decision@1)") { options[:json] = true }
  opts.on("-s", "--seed N", Integer, "Seed for deterministic bandit/MCTS") { |n| options[:seed] = n }
  opts.on("--packs DIR", "Load technique packs (armor + corpus guard) for analyze/explain") { |v| options[:packs] = v }
  opts.on("--version", "Print the version") do
    puts VERSION_LINE
    exit 0
  end
  opts.on("-h", "--help", "Show this help") do
    puts opts
    exit 0
  end
end
parser.parse!

command = ARGV.shift

case command
when "--version", "-v"
  puts VERSION_LINE
when "doctor"
  checks = []
  checks << ["ruby >= 3.4", (RUBY_VERSION >= "3.4") ? nil : "upgrade ruby (mise install ruby@3.4)"]
  checks << [VERSION_LINE, nil]

  # The corpus self-verifies: parse a shipped example, decide, compare.
  begin
    example = File.join(__dir__, "../examples/ret2win.facts")
    result = Augure::Pipeline.analyze(facts: File.read(example))
    checks << if result[:ranking].first == "ret2func"
      ["corpus self-test (selected: ret2func)", nil]
    else
      ["corpus self-test", "corpus example decided differently - report a bug"]
    end
  rescue => e
    checks << ["corpus self-test", e.message]
  end

  solvers = %w[z3 bitwuzla cvc5].select do |s|
    system("sh", "-c", "command -v '#{s}' >/dev/null 2>&1")
  end
  checks << ["SMT solvers",
    solvers.empty? ? "optional - none found; the arithmetic path works without (apt install z3 for the SMT path)" : "optional, found: #{solvers.join(", ")}"]

  failed = false
  checks.each do |name, problem|
    if problem&.start_with?("optional")
      puts "  opt   #{name} - #{problem}"
    elsif problem
      failed = true
      puts "  FAIL  #{name} - fix: #{problem}"
    else
      puts "  ok    #{name}"
    end
  end
  if failed
    n = checks.count { |_, p| p && !p.start_with?("optional") }
    abort("augure: doctor found #{n} issue(s) - fixes above")
  end
when "rules"
  Augure::Rules.all.each do |rule|
    puts rule.id
    puts "  head: #{rule.head.join("=")}"
    puts "  why:  #{rule.source}"
  end
when "explain"
  technique = ARGV.shift or abort(parser.to_s)
  packs = options[:packs] && Augure::PackLoader.load_dir(options[:packs]).tap { |ps| Augure::PackLoader.corpus_guard(ps) }
  rules = Augure::Rules.all + packs.to_a.flat_map(&:rules)
  rules = rules.select { |r| r.head == [Augure::Rules::APPLICABLE, technique] }
  entries = Augure::KnowledgeBase.corpus_with(packs.to_a.flat_map(&:kb))
    .select { |e| e["technique"] == technique }
  if rules.empty? && entries.empty?
    known = Augure::Rules.applicable_rules.map { |r| r.head[1] }.uniq.sort
    abort("augure: unknown technique '#{technique}' - known: #{known.join(", ")}")
  end
  puts "technique: #{technique}"
  rules.each do |rule|
    puts "  rule: #{rule.id} - #{rule.source}"
  end
  entries.each do |e|
    puts "  kb:   #{e["id"]} (success_rate #{e["success_rate"]})"
    puts "        #{e["description"]}"
  end
when "analyze"
  path = ARGV.shift or abort(parser.to_s)
  input = (path == "-") ? $stdin.read : File.read(path)
  begin
    packs = options[:packs] && Augure::PackLoader.load_dir(options[:packs]).tap { |ps| Augure::PackLoader.corpus_guard(ps) }
    result = Augure::Pipeline.analyze(facts: input, seed: options[:seed], packs: packs)
    if options[:json]
      puts JSON.pretty_generate({schema: "augure/decision@1"}.merge(result))
    else
      puts "applicable: #{result[:applicable].join(", ")}"
      puts "selected:   #{result[:selected]}"
      puts "plan:       #{result[:plan].join(" -> ")}"
      result[:explain][:provenance].each do |tech, provs|
        provs.each do |p|
          puts "  #{tech} <- #{p[:rule]} (#{p[:evidence].map { |e| e.join("=") }.join(", ")})"
        end
      end
    end
  rescue Augure::MalformedFact, Augure::UnknownPredicate => e
    abort("augure: #{e.message}")
  end
else
  abort(parser.to_s)
end
